<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Public TV listings access is requested only after profile opt-in. No storage, location or account access. Package visibility: Leanback launcher apps and known streaming packages;
         Broad package visibility is deliberately not requested. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.amazon.avod" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.hbo.hbonow" />
    </queries>
    <!-- usesCleartextTraffic (owner decision 2026-11-12, F6h): home Jellyfin/Emby/Plex servers commonly answer only on http://<LAN address>.
         Android cannot scope cleartext to private address ranges, so the permission is app-wide and the gate is in code:
         mediaserver/ServerAddress allows http ONLY for a private-LAN host that the person approved for that server, never for a public
         host. Every other client in this app uses a fixed https:// URL and follows no redirects. -->
    <!-- Android 14 requires network-state permission for JobScheduler network constraints. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <application
        android:label="AuraOS v2 Demo"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AuraOSv2">
        <service android:name="no.aura.os.v2.notifications.NotificationRefreshJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name="no.aura.os.v2.notifications.AuraNotificationListener" android:label="AuraOS notification access" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <service android:name="no.aura.os.v2.launcher.AuraHomeShortcutService"
            android:label="@string/home_shortcut_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_shortcut_service" />
        </service>
        <activity
            android:name="no.aura.os.v2.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".simkl.SimklSyncJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
